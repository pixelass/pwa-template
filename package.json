{
  "name": "pwa-template",
  "version": "1.0.0",
  "description": "PWA template with Next.js and MUI",
  "license": "MIT",
  "author": {
    "name": "Gregor Adams",
    "url": "https://github.com/pixelass"
  },
  "main": "n.a.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "yarn favicons && next build",
    "build:test": "yarn favicons && yarn dlx cross-env@7 NODE_ENV=test next build",
    "cypress": "yarn dlx cypress@10 open --e2e",
    "cypress:run": "yarn dlx cypress@10 run",
    "cypress:record": "yarn dlx env-cmd -f '.env.local' yarn dlx cypress@10 run --record",
    "dev": "yarn favicons && next dev",
    "eslint": "eslint '{**/*,*}{.,.config.}{js,mjs,ts,tsx}'",
    "eslint:fix": "yarn eslint --fix",
    "favicons": "node scripts/favicons.mjs",
    "postinstall": "husky install",
    "jest": "jest",
    "jest:watch": "jest --watch",
    "lint": "yarn tsc:noEmit && yarn eslint && yarn stylelint && next lint",
    "ncu": "yarn dlx npm-check-updates@16 -u --dep='prod,dev'",
    "ncu:minor": "yarn ncu -t minor",
    "ncu:patch": "yarn ncu -t patch",
    "prettier": "prettier '{**/*,*}{.,.config.}{js,mjs,ts,tsx}'",
    "release": "yarn dlx standard-version@9",
    "setup": "node scripts/setup.mjs",
    "spj": "yarn dlx sort-package-json@1 package.json",
    "start": "next start",
    "storybook": "start-storybook -p 6006 -s ./public",
    "storybook:build": "build-storybook  -s ./public",
    "stylelint": "stylelint '{**/*,*}.{ts,tsx}'",
    "test": "yarn test:jest && yarn test:cypress",
    "test:cypress": "yarn dlx start-server-and-test@1 start http://localhost:3000 cypress:run",
    "test:jest": "yarn jest",
    "toc": "yarn dlx markdown-toc@1 README.md -i",
    "tsc:noEmit": "tsc --noEmit",
    "unimported": "yarn dlx unimported@1"
  },
  "dependencies": {
    "@emotion/cache": "11.10.3",
    "@emotion/react": "11.10.4",
    "@emotion/server": "11.10.0",
    "@emotion/styled": "11.10.4",
    "@graphql-yoga/node": "2.13.13",
    "@lottiefiles/react-lottie-player": "^3.4.7",
    "@mui/icons-material": "5.10.9",
    "@mui/lab": "5.0.0-alpha.103",
    "@mui/material": "5.10.9",
    "axios": "1.1.3",
    "clsx": "1.2.1",
    "graphql": "16.6.0",
    "nanoid": "4.0.0",
    "next": "12.3.1",
    "next-auth": "4.14.0",
    "next-i18next": "12.1.0",
    "next-pwa": "5.6.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "7.37.0",
    "react-i18next": "^11.18.6",
    "swr": "2.0.0-rc.0",
    "unsplash-js": "7.0.15",
    "zustand": "4.1.2"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^13.0.2",
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@cypress/browserify-preprocessor": "^3.0.2",
    "@cypress/webpack-dev-server": "^2.4.0",
    "@cypress/webpack-preprocessor": "^5.14.0",
    "@jest/globals": "^29.2.0",
    "@mdx-js/react": "^2.1.5",
    "@panva/hkdf": "^1.0.2",
    "@sentry/nextjs": "^7.15.0",
    "@storybook/addon-actions": "^6.5.12",
    "@storybook/addon-essentials": "^6.5.12",
    "@storybook/addon-interactions": "^6.5.12",
    "@storybook/addon-links": "^6.5.12",
    "@storybook/builder-webpack5": "^6.5.12",
    "@storybook/manager-webpack5": "^6.5.12",
    "@storybook/node-logger": "^6.5.12",
    "@storybook/react": "^6.5.12",
    "@storybook/testing-library": "^0.0.13",
    "@swc/core": "^1.3.9",
    "@swc/jest": "^0.2.23",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/node": "^16.11.45",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "@types/testing-library__jest-dom": "^5.14.5",
    "@typescript-eslint/eslint-plugin": "^5.40.1",
    "@typescript-eslint/parser": "^5.40.1",
    "boxen": "^7.0.0",
    "chalk": "^5.1.2",
    "cypress": "^10.10.0",
    "dotenv": "^16.0.3",
    "eslint": "^8.25.0",
    "eslint-config-next": "^12.3.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-typescript": "^3.0.0",
    "eslint-config-xo": "^0.42.0",
    "eslint-config-xo-react": "^0.27.0",
    "eslint-config-xo-typescript": "^0.53.0",
    "eslint-plugin-jest": "^27.1.2",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.31.10",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^0.6.6",
    "eslint-plugin-unicorn": "^44.0.2",
    "execa": "^6.1.0",
    "favicons": "^7.0.1",
    "husky": "^8.0.1",
    "i18next-browser-languagedetector": "^6.1.8",
    "i18next-http-backend": "^1.4.4",
    "inquirer": "^9.1.4",
    "jest": "^29.2.0",
    "jest-config": "^29.2.0",
    "jest-environment-jsdom": "^29.2.0",
    "jose": "^4.10.0",
    "lint-staged": "^13.0.3",
    "next-transpile-modules": "^9.1.0",
    "ora": "^6.1.2",
    "path-browserify": "^1.0.1",
    "prettier": "^2.7.1",
    "standard-version": "^9.5.0",
    "storybook-addon-next": "^1.6.9",
    "storybook-react-i18next": "^1.1.2",
    "stylelint": "^13.13.1",
    "stylelint-a11y": "^1.2.3",
    "stylelint-config-prettier": "^8.0.2",
    "stylelint-config-property-sort-order-smacss": "^7.1.0",
    "stylelint-config-standard": "^22.0.0",
    "stylelint-config-styled-components": "^0.1.1",
    "stylelint-order": "^4.1.0",
    "stylelint-processor-styled-components": "^1.10.0",
    "type-fest": "^3.1.0",
    "typescript": "^4.8.4",
    "webpack": "^5.74.0"
  },
  "packageManager": "yarn@3.2.0"
}
